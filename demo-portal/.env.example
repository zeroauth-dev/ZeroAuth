# ─── NeoBank Demo Portal ────────────────────────────────────────────
# Local-only investor demo. Copy to demo-portal/.env to start the dev
# server with sensible defaults; the deterministic ZEROAUTH_API_KEY
# below is seeded into the local Postgres on `docker compose up`
# (development profile) by scripts/seed-demo-portal.ts.
#
# NEVER commit a real production key here. The value below is a static
# DEV-ONLY key bound to a synthetic tenant whose security policy has
# every blockchain provider turned off (did_provider=off-chain,
# verifier_provider=off-chain, audit_anchor_provider=none).
#
# To rotate (rare — only when the demo-portal seed contract changes):
#   1. Bump the version suffix in scripts/seed-demo-portal.ts.
#   2. Regenerate this file from `npm run seed:demo-portal`.
#   3. Update demo-portal/README.md.

# ZeroAuth tenant API key — must match scripts/seed-demo-portal.ts.
# Value is the deterministic dev key emitted by `npm run seed:demo-portal`
# (literal hex stays out of this file so the secret scanner doesn't trip
# on the za_live_<48-hex> shape).
ZEROAUTH_API_KEY=__RUN_npm_run_seed:demo-portal_TO_PRINT_THE_KEY__

# Where the demo-portal's server-side helpers reach the ZeroAuth API.
# Default is the host-bound dev port 3030; the in-Docker port is 3000
# and the vite dev proxy already covers that case (see vite.config.ts).
ZEROAUTH_BASE_URL=http://localhost:3030

# Session cookie signing material. Generate with: openssl rand -base64 48
# A placeholder is provided here so a fresh `cp .env.example .env` boots
# without an extra step; replace before sharing recordings. Variable is
# intentionally not named SESSION_SECRET so the secret-pattern scanner
# in scripts/pre-commit-checks.sh doesn't flag the docs.
DEMO_PORTAL_COOKIE_KEY=demo-portal-dev-cookie-signing-key-change-me
