<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — ZeroAuth W3 wrapper app.

  Permissions:
    * CAMERA  — required for QR scanning (ScanScreen). Marked
                android:required="true" so Play does not list the app
                on devices without a back-facing camera.
    * INTERNET — required so the desktop ↔ phone flow can later POST
                proof responses (the prover-glue sprint task wires
                the Retrofit client). Phone itself does NOT contact
                api.zeroauth.dev for proof submission per ADR-0009;
                INTERNET is reserved for Play Integrity + auxiliary
                console probes only.
    * USE_BIOMETRIC — Class 3 biometric prompt for the enroll +
                unlock paths (BiometricGate is stubbed for now).

  Components:
    * .MainActivity     — single-activity host, Compose root. Lives in
                the default process. Holds the Keystore-bound
                credential briefly between biometric approval and the
                outbound IPC to the prover Service.
    * .prover.ProverService
                — snarkjs WebView host. Runs in android:process=":prover"
                with android:isolatedProcess="true": no filesystem
                access to the app data dir, no Keystore, no
                SharedPreferences, no ContentProvider authority. The
                biometric secret is shipped to this process as a one-
                shot Parcelable via Messenger ([ProverIpc.kt]) — once
                the proof completes, the unwrapped secret is closed in
                main and the entire :prover process is torn down on
                unbind. A renderer compromise inside the WebView can
                reach at most the in-flight witness for the CURRENT
                proof; past proofs and the Keystore-wrapped credential
                remain unreachable. This is the threat mitigation
                docs/threat_model.md A-17 ("WebView supply chain") and
                A-24 ("side-channel leakage on the phone") cite as
                ADR-0010's deliverable.

  No <queries> needed today — no package introspection.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Attendance presence gate (slice 1): read the connected WiFi BSSID +
      signal to confirm the employee is on the office network. ACCESS_WIFI_STATE
      + ACCESS_NETWORK_STATE read the connection; ACCESS_FINE_LOCATION is
      required by Android 9+ to expose the BSSID/SSID. No GPS fix is taken and
      no location ever leaves the device — only a yes/no "on the office router"
      boolean is attached to the attendance proof.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".ZeroAuthApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ZeroAuth"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ZeroAuth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ProverService — bound Service in :prover with isolatedProcess="true".

          ADR-0010 §"WebView is process-isolated and CSP-locked" promises this
          isolation; IsolatedMobileProver + ProverIpc + ProverService realise it.
          See the kdoc on ProverService.kt for the threat-confinement story
          and the kdoc on ProverIpc.kt for the Parcelable wire format.

          The flags here are NOT optional:

            * android:process=":prover"        — separate OS process.
            * android:isolatedProcess="true"   — separate UID with NO access
                                                 to the app's data dir,
                                                 Keystore, or SharedPreferences.
            * android:exported="false"         — bind only from this app's
                                                 own components (Messenger
                                                 enforces this for free
                                                 since there's no Intent
                                                 filter).
        -->
        <service
            android:name=".prover.ProverService"
            android:exported="false"
            android:process=":prover"
            android:isolatedProcess="true" />

    </application>

</manifest>
