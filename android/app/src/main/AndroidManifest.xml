<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — ZeroAuth W3 wrapper app.

  Permissions:
    * CAMERA  — required for QR scanning (ScanScreen). Marked
                android:required="true" so Play does not list the app
                on devices without a back-facing camera.
    * INTERNET — required so the desktop ↔ phone flow can later POST
                proof responses (the prover-glue sprint task wires
                the Retrofit client). Phone itself does NOT contact
                api.zeroauth.dev for proof submission per ADR-0009;
                INTERNET is reserved for Play Integrity + auxiliary
                console probes only.
    * USE_BIOMETRIC — Class 3 biometric prompt for the enroll +
                unlock paths (BiometricGate is stubbed for now).

  Components:
    * .MainActivity  — single-activity host, Compose root. Hosts the
                WebViewMobileProver inline in the main process today
                (see TODO in WebViewMobileProver.kt and the "Deferred:
                WebView process isolation" note in ADR-0010 §"WebView
                is process-isolated and CSP-locked"). Process
                isolation is gated on the IPC plumbing — a Messenger
                or AIDL binder between MainActivity and a future
                ProverActivity running android:process=":prover".
                Scheduled work, not stubbed scaffolding.

  No <queries> needed today — no package introspection.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".ZeroAuthApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ZeroAuth"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.ZeroAuth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          DEFERRED: dedicated prover activity in android:process=":prover".

          ADR-0010 §"WebView is process-isolated and CSP-locked" calls for
          hosting the snarkjs WebView in its own OS process. The W3 prover
          (WebViewMobileProver.kt) currently lives inline in the main
          activity's process because the IPC plumbing — Messenger / AIDL
          binder between MainActivity and a future ProverActivity — is its
          own ~day-of-work and we shipped W3 without it. Threat model
          A-17 acknowledges the residual risk: a WebView renderer
          compromise has line-of-sight into the main process where the
          Keystore-unwrapped biometric secret lives during proof
          generation.

          To uncomment when the IPC layer lands (W4+):

          <activity
              android:name=".prover.ProverActivity"
              android:exported="false"
              android:process=":prover"
              android:theme="@style/Theme.ZeroAuth.Prover" />

          (The asset loader at https://appassets.androidplatform.net is
          configured per-WebView by WebViewMobileProver — no manifest
          provider needed even after the move.)
        -->

    </application>

</manifest>
