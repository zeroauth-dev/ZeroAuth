<?xml version="1.0" encoding="utf-8"?>
<!-- ZeroAuth launcher background — a premium deep indigo→near-black
     diagonal gradient. Full-bleed across the 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
  <path android:pathData="M0,0 h108 v108 h-108 z">
    <aapt:attr name="android:fillColor">
      <gradient android:type="linear"
          android:startX="0" android:startY="0"
          android:endX="108" android:endY="108">
        <item android:offset="0" android:color="#FF1B1740"/>
        <item android:offset="0.55" android:color="#FF120F2A"/>
        <item android:offset="1" android:color="#FF09090F"/>
      </gradient>
    </aapt:attr>
  </path>
</vector>
